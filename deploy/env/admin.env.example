BRUD_DEPLOYMENT_MODE=admin
BRUD_DEFER_ADMIN_TOOL_ROUTES=false
# Admin should be reached only through a TLS-terminating reverse proxy.
HOST=127.0.0.1
PORT=8001
BRUD_ADMIN_COOKIE_SECURE=true
# BRUD_TRUST_PROXY_HEADERS is now consumed directly by
# deploy/scripts/start-admin.sh (Phase 6B-3): when true, uvicorn is
# started with --proxy-headers --forwarded-allow-ips=<this value>, so
# only requests forwarded by an IP in BRUD_TRUSTED_PROXY_IPS have their
# X-Forwarded-* headers trusted. Keep this to the reverse proxy's own
# address (127.0.0.1 for the same-host nginx/Caddy templates) --
# trusting it from anywhere lets any client spoof its own client IP.
BRUD_TRUST_PROXY_HEADERS=true
BRUD_TRUSTED_PROXY_IPS=127.0.0.1
