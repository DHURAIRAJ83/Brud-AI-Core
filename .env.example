BRUD_ENV=development
BRUD_HOST=127.0.0.1
BRUD_PORT=8000
BRUD_DATABASE_PATH=data/database/brud_ai.db
BRUD_LOG_LEVEL=INFO
BRUD_CHATBOT_ORIGIN=http://localhost:5173
BRUD_ADMIN_ORIGIN=http://localhost:5174
BRUD_DEBUG=false
BRUD_DATABASE_BACKUP_DIR=data/database/backups
BRUD_DATABASE_BUSY_TIMEOUT_MS=5000
BRUD_DATABASE_WAL=true
BRUD_DATABASE_AUTO_BACKUP=true
BRUD_AUDIT_ENABLED=true
BRUD_AUDIT_RETENTION_DAYS=365
BRUD_MAX_METADATA_BYTES=65536
BRUD_ALLOWED_DATA_DIR=data
BRUD_ALLOWED_MODEL_DIR=models
BRUD_ALLOWED_EXPORT_DIR=models/exports
BRUD_ALLOW_EXTERNAL_STORAGE=false
BRUD_ADMIN_SESSION_TTL_MINUTES=480
BRUD_ADMIN_MAX_FAILED_LOGINS=5
BRUD_ADMIN_LOCKOUT_MINUTES=15
BRUD_ADMIN_COOKIE_SECURE=false
BRUD_ADMIN_COOKIE_NAME=brud_admin_session
BRUD_CSRF_COOKIE_NAME=brud_csrf
BRUD_CSRF_HEADER_NAME=X-CSRF-Token
