# Brud AI -- nginx reverse-proxy + TLS termination template.
#
# Copy this file, fill in your actual domain names and certificate
# paths, and install it under nginx's sites-available/ (symlinked into
# sites-enabled/). This is a template, not a ready-to-use config --
# every <PLACEHOLDER> below must be replaced before use.
#
# Matches this repo's deploy/env/*.env.example bindings:
#   public -> 127.0.0.1:8000 (upstream only; nginx is what's actually
#             internet-reachable, not uvicorn directly)
#   admin  -> 127.0.0.1:8001 (local-only upstream, reached only through
#             this proxy -- see deploy/env/admin.env.example)
#   worker -> 127.0.0.1:8002 (intentionally NOT proxied here -- worker
#             is local-only by design; if you ever need to reach its
#             /api/health for debugging, use an SSH tunnel instead of
#             exposing it through nginx)

# ---------------------------------------------------------------------
# Public API -- externally reachable, TLS-terminated here.
# ---------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name <PUBLIC_DOMAIN>;

    # ACME/Let's Encrypt HTTP-01 challenge path, if used.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <PUBLIC_DOMAIN>;

    ssl_certificate     <PATH_TO_PUBLIC_FULLCHAIN_PEM>;
    ssl_certificate_key <PATH_TO_PUBLIC_PRIVKEY_PEM>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Security response headers (HSTS, X-Content-Type-Options,
    # X-Frame-Options, Referrer-Policy) are set by the app itself
    # (backend/core/security_headers_middleware.py, Phase 6B-3) so they
    # also cover any direct-to-backend access path, not just requests
    # proxied through here. Don't duplicate them with add_header --
    # nginx doesn't override an existing upstream header, it appends
    # another one of the same name, which most clients don't dedupe.

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}

# ---------------------------------------------------------------------
# Admin API -- serve on a separate subdomain with its own certificate,
# so the admin login is never reachable via the public hostname at all.
# Consider adding `allow <TRUSTED_IP>; deny all;` inside the location
# block below for defense-in-depth beyond TLS + cookie auth.
# ---------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name <ADMIN_DOMAIN>;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <ADMIN_DOMAIN>;

    ssl_certificate     <PATH_TO_ADMIN_FULLCHAIN_PEM>;
    ssl_certificate_key <PATH_TO_ADMIN_PRIVKEY_PEM>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Security response headers are set by the app itself
    # (backend/core/security_headers_middleware.py, Phase 6B-3) -- see
    # the matching comment in the public server block above.

    # Optional defense-in-depth -- uncomment and fill in to restrict the
    # admin panel to known source IPs in addition to cookie auth:
    # allow <TRUSTED_IP>;
    # deny all;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
