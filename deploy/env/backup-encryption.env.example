# Brud AI -- backup-encryption key.
#
# Deliberately a SEPARATE file from public.env/admin.env/worker.env: the
# backup-encryption key should not sit in the same environment file as
# general app config, and this file should have stricter permissions
# (chmod 600, readable only by the service account) than the others.
#
# Generate a real key with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# The variable name below (BRUD_BACKUP_ENCRYPTION_KEY) matches
# Settings.backup_encryption_key_env_var's default. If that setting is
# overridden elsewhere, this variable's *name* must match it exactly --
# the app reads the key from whichever environment variable name
# BRUD_BACKUP_ENCRYPTION_KEY_ENV_VAR points to, not a fixed name.
BRUD_BACKUP_ENCRYPTION_KEY=<GENERATE_WITH_THE_COMMAND_ABOVE_DO_NOT_COMMIT>
